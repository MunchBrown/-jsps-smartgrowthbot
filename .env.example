# Smart Growth Bot Painting AI — server configuration.
# Copy to .env for local development. In production set these as secrets in
# your hosting provider (Cloud Run / AI Studio secrets). Never commit real values.

# --- Required -----------------------------------------------------------------
# Public URL of the app (no trailing slash). Used in customer links, OAuth and webhooks.
APP_URL="https://app.smartgrowthbot.com"
# 32-byte key that encrypts each company's Twilio/Vapi/Google secrets.
# Generate with: openssl rand -hex 32   (keep it forever; changing it breaks saved connections)
ENCRYPTION_KEY=""
# Gemini API key for all AI features.
GEMINI_API_KEY=""
# Optional: override the Gemini model.
# GEMINI_MODEL="gemini-3.5-flash"

# Comma-separated emails of Smart Growth Bot operators who can grant free beta access.
PLATFORM_ADMIN_EMAILS=""

# --- Firebase (sign-in + database) ----------------------------------------------
# On Cloud Run in the same Google project, leave this empty (uses the service account).
# Elsewhere, paste the Firebase service-account JSON (raw or base64).
FIREBASE_SERVICE_ACCOUNT=""
# Defaults to the projectId in firebase-applet-config.json.
# FIREBASE_PROJECT_ID=""
# Defaults to firestoreDatabaseId in firebase-applet-config.json.
# FIRESTORE_DATABASE_ID=""

# --- Stripe (subscriptions + customer invoice payments) ---------------------------
STRIPE_SECRET_KEY=""                 # sk_test_... while testing, sk_live_... at launch
STRIPE_WEBHOOK_SECRET=""             # signing secret for {APP_URL}/api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=""     # signing secret for {APP_URL}/api/webhooks/stripe-connect
STRIPE_PRICE_STARTER=""              # price_... ($297/month)
STRIPE_PRICE_PROFESSIONAL=""         # price_... ($697/month)
STRIPE_PRICE_PREMIUM=""              # price_... ($1,497/month)
TRIAL_DAYS=14
# Optional platform fee on invoice payments in basis points (100 = 1%). 0 = none.
PLATFORM_FEE_BPS=0

# --- Google (Calendar + Gmail for each company) ------------------------------------
# OAuth client (Web application). Authorized redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: platform email sender (used when a company hasn't connected Gmail) ----
RESEND_API_KEY=""
EMAIL_FROM=""                        # e.g. notifications@smartgrowthbot.com (verified in Resend)

# --- Optional: live SAM.gov opportunities in the Gov contracting preview --------------
SAM_API_KEY=""

# --- Local testing only. Never set these in production (the server refuses to start). --
# DATA_STORE=memory
# ALLOW_TEST_AUTH=1
